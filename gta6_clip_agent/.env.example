# --- Claude (scoring + packaging) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high

# --- Paths ---
FOOTAGE_DIR=footage
OUTPUT_DIR=out

# --- YouTube: API key for trend search; OAuth (youtube.upload scope) for uploads ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# refresh token scopes: youtube.upload youtube.readonly yt-analytics.readonly
YOUTUBE_REFRESH_TOKEN=

# --- Instagram Graph API (Business/Creator account linked to a Facebook Page) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public folder URL where rendered clips are mirrored (needed for Reels publishing)
PUBLIC_VIDEO_BASE_URL=

# --- TikTok (Login Kit token with video.list + video.upload scopes) ---
# scopes: user.info.basic user.info.stats video.list video.upload
TIKTOK_ACCESS_TOKEN=

SEARCH_TERMS=GTA 6,GTA VI,GTA 6 gameplay

# --- Sources: only videos from approved channels mentioning one of these are picked up ---
SOURCE_KEYWORDS=gta 6,gta vi,gta6,grand theft auto vi

# --- Voiceover for your commentary (optional; captions are used if none is set) ---
# TTS_PROVIDER=auto            # auto | elevenlabs | piper | espeak | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# PIPER_MODEL=/path/to/voice.onnx

# --- Speech-to-text for subtitles (runs locally; the model downloads on first use) ---
# WHISPER_MODEL=small          # tiny | base | small | medium (bigger = more accurate, slower)
# CAMPAIGN_MIN_S=10
# CAMPAIGN_MAX_S=20

# --- Your own voice: recordings in VOICE_DIR named clip_<id>.m4a, pitched by VOICE_PITCH ---
# VOICE_DIR=voice
# VOICE_PITCH=-3               # semitones; negative = deeper
# VOICE_PRESET=warm            # natural_low | warm | narrator | different | light (overrides VOICE_PITCH)
# VOICE_MAX_PAUSE=0.35         # seconds; longer silences in your recording are shortened to this
# VOICE_TARGET_WPM=170         # slow reads are sped up toward this pace
# VOICE_MAX_SPEEDUP=1.12       # ...but never by more than this
