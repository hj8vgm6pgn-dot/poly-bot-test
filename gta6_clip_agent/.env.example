# --- Claude (scoring + packaging) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high

# --- Paths ---
FOOTAGE_DIR=footage
OUTPUT_DIR=out

# --- YouTube: API key for trend search; OAuth (youtube.upload scope) for uploads ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# refresh token scopes: youtube.upload youtube.readonly yt-analytics.readonly
YOUTUBE_REFRESH_TOKEN=

# --- Instagram Graph API (Business/Creator account linked to a Facebook Page) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public folder URL where rendered clips are mirrored (needed for Reels publishing)
PUBLIC_VIDEO_BASE_URL=

# --- TikTok (Login Kit token with video.list + video.upload scopes) ---
# scopes: user.info.basic user.info.stats video.list video.upload
TIKTOK_ACCESS_TOKEN=

SEARCH_TERMS=GTA 6,GTA VI,GTA 6 gameplay

# --- Sources: only videos from approved channels mentioning one of these are picked up ---
SOURCE_KEYWORDS=gta 6,gta vi,gta6,grand theft auto vi

# --- Voiceover for your commentary (optional; captions are used if none is set) ---
# TTS_PROVIDER=auto            # auto | elevenlabs | piper | espeak | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# PIPER_MODEL=/path/to/voice.onnx
